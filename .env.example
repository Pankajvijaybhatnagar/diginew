# Copy this file to .env.local and fill in the values.

# Live website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.digi1xprt.com

# Google Search Console → Add property → "HTML tag" method → paste only the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → "Meta tag" method → paste only the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
